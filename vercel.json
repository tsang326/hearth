{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "public",
  "regions": ["iad1"],
  "functions": {
    "api/*.ts": {
      "maxDuration": 60,
      "includeFiles": "{node_modules/@modelcontextprotocol/ext-apps/dist/src/app-with-deps.js,skills/hearth/SKILL.md}"
    }
  },
  "rewrites": [
    { "source": "/mcp", "destination": "/api/mcp" },
    { "source": "/phone", "destination": "/phone.html" }
  ]
}
